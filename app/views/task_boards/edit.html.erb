<div class="mx-auto max-w-2xl space-y-5">
  <div class="flex items-center justify-between gap-3">
    <h1 class="text-2xl font-bold text-slate-900"><%= t("tasks.customize_title") %></h1>
    <%= link_to t("tasks.back_to_board"), task_board_path(@board), class: "text-sm font-medium text-emerald-700 hover:underline" %>
  </div>

  <section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
    <%= form_with model: @board, class: "flex flex-wrap items-end gap-3" do |f| %>
      <div class="min-w-0 flex-1">
        <%= f.label :name, t("tasks.board_name"), class: "mb-1 block text-xs font-medium text-slate-600" %>
        <%= f.text_field :name, required: true, maxlength: 80, class: "w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" %>
      </div>
      <%= f.submit t("tasks.save"), class: "rounded-lg bg-emerald-600 px-4 py-2 text-sm font-semibold text-white hover:bg-emerald-700" %>
    <% end %>
  </section>

  <section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
    <h2 class="font-semibold text-slate-900"><%= t("tasks.columns") %></h2>
    <p class="mb-4 text-xs text-slate-500"><%= t("tasks.columns_edit_hint") %></p>
    <ul class="space-y-3">
      <% @columns.each_with_index do |column, index| %>
        <li class="rounded-xl border border-slate-200 p-3">
          <%= form_with model: column, url: task_board_task_column_path(@board, column), method: :patch, class: "flex flex-wrap items-end gap-2" do |f| %>
            <span class="mb-2.5 h-3 w-3 shrink-0 rounded-full <%= column_style(column, :dot) %>"></span>
            <div class="min-w-0 flex-1">
              <%= f.text_field :name, required: true, maxlength: 40, "aria-label": t("tasks.column_name"),
                    class: "w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" %>
            </div>
            <%= f.select :color, TaskColumn::COLORS.map { |c| [t("tasks.colors.#{c}"), c] }, {}, "aria-label": t("tasks.color"),
                  class: "rounded-lg border border-slate-300 px-2 py-2 text-sm" %>
            <label class="flex items-center gap-1.5 pb-2 text-xs text-slate-600" title="<%= t('tasks.done_hint') %>">
              <%= f.check_box :done, class: "h-4 w-4 rounded border-slate-300 text-emerald-600" %> <%= t("tasks.done_column") %>
            </label>
            <%= f.submit t("tasks.save"), class: "rounded-lg border border-slate-300 px-3 py-2 text-xs font-medium text-slate-700 hover:bg-slate-50" %>
          <% end %>
          <div class="mt-2 flex items-center gap-2 text-xs text-slate-400">
            <span><%= t("tasks.tasks_count", count: column.tasks.size) %></span>
            <span class="ml-auto"></span>
            <% if index.positive? %>
              <%= button_to "↑", task_board_task_column_path(@board, column), method: :patch, params: { direction: "up" },
                    class: "rounded border border-slate-300 px-2 py-0.5 text-slate-600 hover:bg-slate-50", title: t("tasks.move_left") %>
            <% end %>
            <% if index < @columns.size - 1 %>
              <%= button_to "↓", task_board_task_column_path(@board, column), method: :patch, params: { direction: "down" },
                    class: "rounded border border-slate-300 px-2 py-0.5 text-slate-600 hover:bg-slate-50", title: t("tasks.move_right") %>
            <% end %>
            <% if column.tasks.empty? && @columns.size > 1 %>
              <%= button_to t("memberships.remove"), task_board_task_column_path(@board, column), method: :delete,
                    class: "text-rose-600 hover:underline", form: { data: { turbo_confirm: t("tasks.remove_column_confirm") } } %>
            <% end %>
          </div>
        </li>
      <% end %>
    </ul>

    <%= form_with model: TaskColumn.new, url: task_board_task_columns_path(@board), class: "mt-4 flex flex-wrap items-end gap-2 border-t border-slate-100 pt-4" do |f| %>
      <div class="min-w-0 flex-1">
        <%= f.label :name, t("tasks.add_column"), class: "mb-1 block text-xs font-medium text-slate-600" %>
        <%= f.text_field :name, required: true, maxlength: 40, class: "w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" %>
      </div>
      <%= f.select :color, TaskColumn::COLORS.map { |c| [t("tasks.colors.#{c}"), c] }, {}, "aria-label": t("tasks.color"),
            class: "rounded-lg border border-slate-300 px-2 py-2 text-sm" %>
      <%= f.submit t("tasks.add"), class: "rounded-lg bg-emerald-600 px-4 py-2 text-sm font-semibold text-white hover:bg-emerald-700" %>
    <% end %>
  </section>

  <section class="rounded-2xl border border-rose-200 bg-white p-5 shadow-sm">
    <h2 class="font-semibold text-rose-700"><%= t("tasks.remove_board") %></h2>
    <p class="mt-1 text-sm text-slate-600"><%= t("tasks.remove_board_hint", count: @board.tasks.count) %></p>
    <%= button_to t("tasks.remove_board"), task_board_path(@board), method: :delete,
          class: "mt-3 rounded-lg border border-rose-300 px-4 py-2 text-sm font-semibold text-rose-700 hover:bg-rose-50",
          form: { data: { turbo_confirm: t("tasks.remove_board_confirm", name: @board.name) } } %>
  </section>
</div>
