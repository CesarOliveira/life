<div class="mx-auto max-w-md space-y-5">
  <section class="rounded-2xl border border-rose-200 bg-white p-6 shadow-sm">
    <h1 class="text-xl font-bold text-rose-700"><%= t("user_deletion.title") %></h1>
    <p class="mt-2 text-sm text-slate-600"><%= t("user_deletion.intro", email: current_user.email) %></p>

    <% if (reason = @deletion.blocked_reason) %>
      <p class="mt-4 rounded-lg border border-amber-200 bg-amber-50 p-3 text-sm text-amber-800"><%= t("user_deletion.blocked.#{reason}") %></p>
    <% else %>
      <h2 class="mt-5 text-sm font-semibold text-slate-800"><%= t("user_deletion.what_title") %></h2>
      <ul class="mt-2 list-disc space-y-1 pl-5 text-sm text-slate-600">
        <% %w[data access assistants].each do |key| %><li><%= t("user_deletion.what.#{key}") %></li><% end %>
      </ul>

      <% shared = @accounts.select { |a| a.memberships.count { |m| m.active? && m.user_id != current_user.id }.positive? } %>
      <% if shared.any? %>
        <p class="mt-4 rounded-lg bg-slate-50 p-3 text-xs text-slate-600">
          <%= t("user_deletion.shared", names: shared.map(&:name).to_sentence) %>
        </p>
      <% end %>

      <p class="mt-4 text-sm font-medium text-slate-800"><%= t("user_deletion.irreversible") %></p>

      <%= form_with url: delete_account_path, method: :delete, data: { controller: "type-to-confirm", type_to_confirm_word_value: UserDeletionsController::CONFIRMATION, turbo: false }, class: "mt-4 space-y-3" do %>
        <label class="block text-xs font-medium text-slate-600" for="confirmation"><%= t("user_deletion.type_label", word: UserDeletionsController::CONFIRMATION) %></label>
        <input type="text" name="confirmation" id="confirmation" autocomplete="off" autocapitalize="characters"
               data-type-to-confirm-target="input" data-action="input->type-to-confirm#check"
               class="w-full rounded-lg border border-slate-300 px-3 py-2 font-mono text-sm focus:border-rose-500 focus:ring-rose-500"
               placeholder="<%= UserDeletionsController::CONFIRMATION %>">
        <div class="flex items-center justify-end gap-2 pt-1">
          <%= link_to t("habits.cancel"), (current_account ? edit_account_path(current_account) : authenticated_root_path),
                class: "rounded-lg border border-slate-300 px-4 py-2 text-sm text-slate-600 hover:bg-slate-50" %>
          <%= submit_tag t("user_deletion.submit"), data: { type_to_confirm_target: "button" },
                class: "cursor-pointer rounded-lg bg-rose-600 px-4 py-2 text-sm font-semibold text-white hover:bg-rose-700 disabled:cursor-not-allowed disabled:opacity-40" %>
        </div>
      <% end %>
    <% end %>
  </section>
</div>
