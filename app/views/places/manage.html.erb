<div class="space-y-6">
  <div class="flex flex-wrap items-end justify-between gap-3">
    <div>
      <h1 class="text-2xl font-bold text-slate-900"><%= t("places.manage_title") %></h1>
      <p class="mt-1 text-sm text-slate-500"><%= t("places.manage_subtitle") %></p>
    </div>
    <%= link_to "‹ #{t('places.back_to_timeline')}", places_path, class: "rounded-lg border border-slate-300 px-3 py-1.5 text-sm font-medium text-slate-700 hover:bg-slate-50" %>
  </div>

  <%# Sugestões: lugares frequentes ainda sem nome %>
  <% if @suggestions.any? %>
    <section class="rounded-2xl border border-amber-200 bg-white p-5 shadow-sm">
      <h2 class="font-semibold text-slate-900"><%= t("places.suggestions_title") %></h2>
      <p class="mb-4 text-xs text-slate-500"><%= t("places.suggestions_hint") %></p>
      <ul class="divide-y divide-slate-100">
        <% @suggestions.each do |c| %>
          <li class="flex flex-col gap-2 py-3 sm:flex-row sm:items-center sm:justify-between">
            <div class="min-w-0">
              <p class="truncate text-sm font-medium text-slate-900"><%= c.address.presence || t("places.unnamed") %></p>
              <p class="text-xs text-slate-500"><%= t("places.cluster_stats", hours: number_with_delimiter(c.hours), visits: c.visits) %> ·
                <%= link_to t("places.see_on_map"), "https://www.openstreetmap.org/?mlat=#{c.lat.round(5)}&mlon=#{c.lng.round(5)}#map=17/#{c.lat.round(5)}/#{c.lng.round(5)}",
                      target: "_blank", rel: "noopener noreferrer", class: "text-emerald-700 hover:underline" %></p>
            </div>
            <%= form_with url: places_path, scope: :place, class: "flex gap-2", data: { turbo: false } do |f| %>
              <%= f.hidden_field :latitude, value: c.lat %>
              <%= f.hidden_field :longitude, value: c.lng %>
              <%= f.hidden_field :address, value: c.address %>
              <%= f.text_field :name, value: c.suggested_name, placeholder: t("places.name_placeholder"), required: true, maxlength: 80,
                    class: "w-44 rounded-lg border border-slate-300 px-2 py-1.5 text-sm" %>
              <%= f.submit t("places.name_button"), class: "cursor-pointer rounded-lg bg-emerald-600 px-3 py-1.5 text-sm font-semibold text-white hover:bg-emerald-700" %>
            <% end %>
          </li>
        <% end %>
      </ul>
    </section>
  <% end %>

  <%# Lugares nomeados %>
  <section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
    <h2 class="mb-1 font-semibold text-slate-900"><%= t("places.named_title") %></h2>
    <p class="mb-4 text-xs text-slate-500"><%= t("places.named_hint") %></p>
    <% if @places.empty? %>
      <p class="text-sm text-slate-500"><%= t("places.named_empty") %></p>
    <% else %>
      <ul class="divide-y divide-slate-100">
        <% @places.each do |place| %>
          <% row = @stats[place] %>
          <li class="flex flex-col gap-2 py-3 md:flex-row md:items-center md:justify-between">
            <%= form_with model: place, url: place_path(place), method: :patch, scope: :place, class: "flex flex-wrap items-center gap-2", data: { turbo: false } do |f| %>
              <%= f.text_field :name, required: true, maxlength: 80, class: "w-48 rounded-lg border border-slate-300 px-2 py-1.5 text-sm font-medium" %>
              <label class="flex items-center gap-1 text-xs text-slate-500"><%= t("places.radius") %>
                <%= f.number_field :radius_m, min: Place::MIN_RADIUS, max: Place::MAX_RADIUS, step: 10, class: "w-20 rounded-lg border border-slate-300 px-2 py-1.5 text-sm" %> m
              </label>
              <%= f.submit t("places.save"), class: "cursor-pointer rounded-lg border border-slate-300 px-3 py-1.5 text-xs font-medium text-slate-700 hover:bg-slate-50" %>
            <% end %>
            <div class="flex items-center gap-4">
              <p class="text-xs text-slate-500">
                <%= row ? t("places.last_30", time: humanize_duration(row.seconds), days: row.days.size) : t("places.last_30_none") %>
              </p>
              <%= button_to t("places.remove"), place_path(place), method: :delete, class: "text-xs text-slate-400 hover:text-rose-600",
                    form: { data: { turbo_confirm: t("places.remove_confirm", name: place.name) } } %>
            </div>
          </li>
        <% end %>
      </ul>
    <% end %>
  </section>

  <%# Importar a Linha do Tempo do Google %>
  <section id="importar" class="scroll-mt-16 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm"
           data-controller="places-import" data-places-import-url-value="<%= import_places_path %>">
    <h2 class="mb-1 font-semibold text-slate-900"><%= t("places.import_title") %></h2>
    <p class="mb-3 text-xs text-slate-500"><%= t("places.import_hint") %></p>
    <ol class="mb-4 list-decimal space-y-1 pl-5 text-sm text-slate-600">
      <% %w[android iphone takeout].each do |key| %><li><%= t("places.import_steps.#{key}") %></li><% end %>
    </ol>
    <div class="flex flex-wrap items-center gap-3">
      <input type="file" accept=".json,application/json" multiple data-places-import-target="input" class="text-sm">
      <button type="button" data-action="places-import#import" data-places-import-target="button"
              class="rounded-lg bg-emerald-600 px-4 py-2 text-sm font-semibold text-white hover:bg-emerald-700 disabled:opacity-50"><%= t("places.import_button") %></button>
    </div>
    <p class="mt-2 text-sm text-slate-600" data-places-import-target="status" aria-live="polite"></p>
    <p class="mt-3 text-xs text-slate-400"><%= t("places.import_privacy") %></p>
  </section>

  <%# Seus dados de localização %>
  <section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
    <h2 class="mb-1 font-semibold text-slate-900"><%= t("places.data_title") %></h2>
    <p class="text-sm text-slate-600">
      <%= @visit_count.zero? ? t("places.data_none") : t("places.data_summary", count: @visit_count, from: l(@first_day, format: :long), to: l(@last_day, format: :long)) %>
    </p>
    <p class="mt-1 text-xs text-slate-500"><%= t("places.data_privacy") %></p>
    <% if @visit_count.positive? %>
      <%= button_to t("places.delete_all"), places_history_path, method: :delete,
            class: "mt-3 rounded-lg border border-rose-300 px-3 py-1.5 text-xs font-medium text-rose-700 hover:bg-rose-50",
            form: { data: { turbo_confirm: t("places.delete_all_confirm") } } %>
    <% end %>
  </section>
</div>
