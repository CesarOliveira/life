<% content_for :head do %><%= stylesheet_link_tag "leaflet" %><% end %>
<% points = @timeline.entries.map { |e| { lat: e.visit.lat, lng: e.visit.lng, name: e.name, named: e.visit.place.present?, minutes: (e.seconds / 60.0).round, label: humanize_duration(e.seconds) } } %>
<div class="space-y-6">
  <div class="flex flex-wrap items-end justify-between gap-3">
    <div>
      <h1 class="text-2xl font-bold text-slate-900"><%= t("places.title") %></h1>
      <p class="mt-1 text-sm text-slate-500"><%= t("places.subtitle") %></p>
    </div>
    <%= link_to t("places.manage_link"), manage_places_path, class: "rounded-lg border border-slate-300 px-3 py-1.5 text-sm font-medium text-slate-700 hover:bg-slate-50" %>
  </div>

  <%# Navegação entre dias %>
  <div class="flex items-center justify-between gap-2 rounded-2xl border border-slate-200 bg-white p-3 shadow-sm">
    <%= link_to "‹ #{t('places.prev_day')}", places_path(dia: @date - 1), class: "rounded-lg px-3 py-1.5 text-sm font-medium text-slate-600 hover:bg-slate-100" %>
    <form action="<%= places_path %>" method="get" class="flex items-center gap-2" data-controller="auto-submit">
      <input type="date" name="dia" value="<%= @date.iso8601 %>" max="<%= Date.current.iso8601 %>" data-action="change->auto-submit#submit"
             class="rounded-lg border border-slate-300 px-2 py-1 text-sm">
      <span class="hidden text-sm font-semibold text-slate-800 sm:inline"><%= l(@date, format: :long) %></span>
    </form>
    <% if @date < Date.current %>
      <%= link_to "#{t('places.next_day')} ›", places_path(dia: @date + 1), class: "rounded-lg px-3 py-1.5 text-sm font-medium text-slate-600 hover:bg-slate-100" %>
    <% else %>
      <span class="px-3 py-1.5 text-sm text-slate-300"><%= t("places.next_day") %> ›</span>
    <% end %>
  </div>

  <% unless @has_any %>
    <div class="rounded-2xl border border-emerald-200 bg-emerald-50 p-5">
      <h2 class="font-semibold text-slate-900"><%= t("places.empty.title") %></h2>
      <p class="mt-1 text-sm text-slate-600"><%= t("places.empty.text") %></p>
      <%= link_to t("places.empty.cta"), manage_places_path(anchor: "importar"), class: "mt-3 inline-flex rounded-lg bg-emerald-600 px-4 py-2 text-sm font-semibold text-white hover:bg-emerald-700" %>
    </div>
  <% end %>

  <div class="grid gap-4 lg:grid-cols-5" data-controller="places-map" data-places-map-points-value="<%= points.to_json %>">
    <div data-places-map-target="frame" class="relative h-[26rem] overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm lg:col-span-3 lg:h-auto lg:min-h-[28rem]">
      <div data-places-map-target="canvas" class="h-full w-full"></div>
      <div class="absolute right-2 top-2 z-[1000] flex gap-2">
        <% if points.any? %>
          <button type="button" data-action="places-map#fit" class="rounded-lg bg-white/95 px-3 py-1.5 text-xs font-semibold text-slate-700 shadow hover:bg-white"><%= t("places.map_fit") %></button>
        <% end %>
        <button type="button" data-action="places-map#toggleFullscreen" class="rounded-lg bg-white/95 px-3 py-1.5 text-xs font-semibold text-slate-700 shadow hover:bg-white">
          <span data-places-map-target="fullscreenLabel" data-open="<%= t("places.map_fullscreen") %>" data-close="<%= t("places.map_close") %>"><%= t("places.map_fullscreen") %></span>
        </button>
      </div>
      <p data-places-map-target="hint" class="pointer-events-none absolute bottom-6 left-1/2 z-[1000] hidden -translate-x-1/2 whitespace-nowrap rounded-full bg-slate-900/70 px-3 py-1 text-xs text-white md:block"><%= t("places.map_hint") %></p>
    </div>

    <div class="space-y-4 lg:col-span-2">
      <section class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm">
        <h2 class="mb-3 text-sm font-semibold text-slate-800"><%= t("places.day_timeline") %></h2>
        <% if @timeline.empty? %>
          <p class="text-sm text-slate-500"><%= @has_any ? t("places.no_visits_day") : t("places.no_visits") %></p>
          <% if @has_any && @last_day && @last_day != @date %>
            <%= link_to t("places.go_last_day", date: l(@last_day, format: :long)), places_path(dia: @last_day), class: "mt-2 inline-block text-sm font-medium text-emerald-700 hover:underline" %>
          <% end %>
        <% else %>
          <ol class="space-y-3">
            <% @timeline.entries.each_with_index do |e, i| %>
              <% v = e.visit %>
              <li class="flex gap-3">
                <span class="mt-0.5 inline-flex h-6 w-6 shrink-0 items-center justify-center rounded-full text-xs font-semibold text-white <%= v.place ? 'bg-emerald-600' : 'bg-amber-500' %>"><%= i + 1 %></span>
                <div class="min-w-0 flex-1">
                  <div class="flex cursor-pointer items-baseline justify-between gap-2 hover:text-emerald-700" data-action="click->places-map#focus" data-places-map-index-param="<%= i %>" title="<%= t("places.show_on_map") %>">
                    <p class="truncate text-sm font-medium text-slate-900"><%= e.name %></p>
                    <p class="shrink-0 text-sm font-semibold text-slate-700"><%= humanize_duration(e.seconds) %></p>
                  </div>
                  <p class="text-xs text-slate-500">
                    <%= e.starts_before ? t("places.since_before") : l(v.arrived_at, format: "%H:%M") %>
                    –
                    <%= v.departed_at.nil? ? t("places.now") : (e.ends_after ? t("places.until_after") : l(v.departed_at, format: "%H:%M")) %>
                  </p>
                  <% unless v.place %>
                    <%= form_with url: places_path, scope: :place, class: "mt-1 flex gap-1", data: { turbo: false } do |f| %>
                      <%= f.hidden_field :latitude, value: v.lat %>
                      <%= f.hidden_field :longitude, value: v.lng %>
                      <%= f.hidden_field :address, value: v.address %>
                      <%= f.text_field :name, placeholder: t("places.name_placeholder"), required: true, maxlength: 80,
                            class: "min-w-0 flex-1 rounded-md border border-slate-300 px-2 py-1 text-xs" %>
                      <%= f.submit t("places.name_button"), class: "cursor-pointer rounded-md bg-emerald-600 px-2 py-1 text-xs font-semibold text-white hover:bg-emerald-700" %>
                    <% end %>
                  <% end %>
                </div>
              </li>
            <% end %>
          </ol>
        <% end %>
      </section>

      <% if @timeline.totals.any? %>
        <section class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm">
          <h2 class="mb-3 text-sm font-semibold text-slate-800"><%= t("places.day_totals") %></h2>
          <% max = @timeline.totals.first.last.to_f %>
          <ul class="space-y-2">
            <% @timeline.totals.each do |name, seconds| %>
              <li>
                <div class="flex justify-between text-sm"><span class="truncate text-slate-700"><%= name %></span><span class="font-medium text-slate-900"><%= humanize_duration(seconds) %></span></div>
                <div class="mt-1 h-1.5 rounded-full bg-slate-100"><div class="h-1.5 rounded-full bg-emerald-500" style="width: <%= max.positive? ? (seconds / max * 100).round : 0 %>%"></div></div>
              </li>
            <% end %>
          </ul>
        </section>
        <%= button_to t("places.delete_day"), places_day_path(dia: @date), method: :delete,
              class: "text-xs text-slate-400 hover:text-rose-600", form: { data: { turbo_confirm: t("places.delete_day_confirm") } } %>
      <% end %>
    </div>
  </div>
</div>
